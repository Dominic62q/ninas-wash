{
  "name": "@niinas/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "db:start": "tsx --env-file-if-exists=.env scripts/db-start.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:create-owner": "tsx --env-file-if-exists=.env scripts/create-owner.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "db:backfill-commissions": "tsx --env-file-if-exists=.env scripts/backfill-commissions.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
