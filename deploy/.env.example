# Copy to .env in the repository folder on the server (cp deploy/.env.example .env), then fill it in.
# chmod 600 .env. Never commit it.

# The API's hostname, pointing at this server (an A record). Caddy gets the HTTPS certificate for it.
API_DOMAIN=api.example.com

# The address people open: the Vercel address, https, no trailing slash.
WEB_ORIGIN=https://niinas-wash.vercel.app

# Both made up once: openssl rand -hex 32
# ORIGIN_SECRET must be the same value as ORIGIN_SECRET in the Vercel project.
# Use only letters and digits in POSTGRES_PASSWORD (hex is fine), it goes into a web address.
POSTGRES_PASSWORD=
ORIGIN_SECRET=

# Customer texts (optional). Leave empty and every text is recorded as "not sent".
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=NiinasWash
