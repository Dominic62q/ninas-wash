# /etc/nginx/sites-available/niinas-api  (replace api.example.com, then: certbot --nginx -d api.example.com)
# The VPS serves the API only. The web app lives on Vercel, which forwards /api to this server.
server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.example.com;

    # certbot fills in ssl_certificate / ssl_certificate_key

    # Expense receipt photos are sent as the raw image (the app allows up to 2.5 MB each), so 1m is too small.
    client_max_body_size 3m;

    # Only Vercel knows this secret (it adds it to every /api request, see vercel.json). Anything else, such as someone
    # hitting this address directly, gets nothing. That also means the visitor address Vercel passes on can be trusted.
    # Put the same value in Vercel as ORIGIN_SECRET. Make it long and random: openssl rand -hex 32
    set $origin_secret "PUT-THE-SAME-LONG-RANDOM-VALUE-HERE";

    location /api/ {
        if ($http_x_origin_secret != $origin_secret) {
            return 403;
        }
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        # Vercel puts the real visitor address in X-Forwarded-For. Keep it, so the sign-in limit sees each person.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Origin-Secret "";
    }

    location / {
        return 404;
    }
}
