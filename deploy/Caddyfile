# Caddy gets and renews the HTTPS certificate for {$API_DOMAIN} by itself.
# It serves the API only. The web app lives on Vercel, which forwards /api here (see vercel.json).
{
	servers {
		# The visitor address arrives in X-Forwarded-For from Vercel. Keep it, so the sign-in limit sees each person.
		# This is safe because nothing without the secret below gets past the first check.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

{$API_DOMAIN} {
	# Only Vercel knows this secret (vercel.json adds it to every /api request). Anything else gets nothing.
	@notvercel not header X-Origin-Secret {$ORIGIN_SECRET}
	handle @notvercel {
		respond 403
	}

	handle /api/* {
		# Receipt photos are sent as the raw image, up to 2.5 MB each.
		request_body {
			max_size 3MB
		}
		reverse_proxy api:3001 {
			header_up -X-Origin-Secret
		}
	}

	handle {
		respond 404
	}
}
