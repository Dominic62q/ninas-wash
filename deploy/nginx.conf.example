# /etc/nginx/sites-available/niinas  (replace wash.example.com, then: certbot --nginx -d wash.example.com)
server {
    listen 80;
    server_name wash.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name wash.example.com;

    # certbot fills in ssl_certificate / ssl_certificate_key

    root /var/www/niinas;          # the folder holding apps/web/dist after a build
    index index.html;

    # nginx drops these server-level headers inside any location that sets its own add_header,
    # so the shared set lives in /etc/nginx/snippets/niinas-headers.conf and is included everywhere.
    include snippets/niinas-headers.conf;

    # Expense receipt photos are sent as the raw image (the app allows up to 2.5 MB each), so 1m is too small.
    client_max_body_size 3m;

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built files get a new name whenever they change, so they can be kept forever.
    location /assets/ {
        include snippets/niinas-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # These must NEVER be cached. If they were, people would not see new versions
    # (the "new version is ready" prompt depends on it).
    location = /sw.js {
        include snippets/niinas-headers.conf;
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        include snippets/niinas-headers.conf;
        add_header Cache-Control "no-cache";
    }

    # Every other path is a screen of the app.
    location / {
        include snippets/niinas-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
